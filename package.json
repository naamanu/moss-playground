{
  "name": "moss-playground",
  "version": "0.1.0",
  "description": "A browser playground for Moss, written in Moss with Rhizoid",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare-runtime": "node scripts/build-runtimes.mjs",
    "dev": "npm run prepare-runtime && moss dev src/playground.moss",
    "build": "npm run prepare-runtime && moss build src/playground.moss -o dist",
    "pretest": "npm run prepare-runtime",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mosslang": "file:../moss",
    "rhizoid": "file:../rhizoid"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
